# Server
PORT=5000
NODE_ENV=development

# Frontend URL (CORS aur invite links ke liye)
CLIENT_URL=http://localhost:5173

# Database (Prisma + SQLite local)
DATABASE_URL="file:./dev.db"

# Jitsi server (development/testing: meet.jit.si)
JITSI_DOMAIN=meet.jit.si

# JWT secret: 32+ characters. Generate karne ka command README mein hai.
# Ye real secret .env mein rakhein, .env.example mein nahi.
JWT_SECRET=replace-with-a-long-random-secret
